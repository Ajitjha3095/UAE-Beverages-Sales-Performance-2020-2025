      <column caption='Sales Efficiency' datatype='real' default-format='p0.00%' name='[Calculation_0346930415636496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) = 0 THEN 0&#13;&#10;ELSE SUM([Net_Sales]) / SUM([Sales])&#13;&#10;END' />
